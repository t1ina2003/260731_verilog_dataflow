{
  "name": "verilog-dataflow-tracker",
  "displayName": "Verilog Dataflow Tracker",
  "description": "Trace Verilog signal dataflow when hovering over a variable",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:verilog",
    "onLanguage:systemverilog"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "verilog",
        "extensions": [
          ".v",
          ".sv"
        ]
      }
    ],
    "commands": [
      {
        "command": "verilogDataflow.addToBlockDiagram",
        "title": "加入至 Dataflow 區塊圖 (Add to Block Diagram)",
        "category": "Verilog Dataflow"
      },
      {
        "command": "verilogDataflow.showBlockDiagram",
        "title": "開啟 Dataflow 區塊圖 (Open Block Diagram)",
        "category": "Verilog Dataflow"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "verilogDataflow.addToBlockDiagram",
          "when": "editorLangId == verilog || editorLangId == systemverilog",
          "group": "verilogDataflow@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.5"
  },
  "publisher": "your-name",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/verilog-dataflow-tracker"
  }
}
